  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Use the Decider Directly (without the agent)\n",
    "\n",
    "You can call Strands Decider 2B directly to see the raw probabilities."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from decider_kit import Decider\n",
    "from agent.decision import QUESTIONS, make_state\n",
    "\n",
    "d = Decider()\n",
    "\n",
    "reasons = [\n",
    "    \"My father lost his job and we cannot afford my tuition.\",\n",
    "    \"I need financial help for my studies.\",\n",
    "    \"I have a CGPA of 9.4 and want the scholarship to fund my research project.\",\n",
    "]\n",
    "\n",
    "for reason in reasons:\n",
    "    state = make_state(reason)\n",
    "    answers = d.ask(state, QUESTIONS)\n",
    "    elig = answers[\"eligibility\"]\n",
    "    gen = answers[\"genuine\"]\n",
    "    fin = answers[\"financial_need\"]\n",
    "    print(f\"Reason: {reason[:60]}...\")\n",
    "    print(f\"  eligibility={elig.label} ({elig.confidence:.2f})  probs={dict((k, round(v,2)) for k,v in elig.probabilities.items())}\")\n",
    "    print(f\"  genuine p_yes={gen.p_yes:.2f}  financial_need p_yes={fin.p_yes:.2f}\")\n",
    "    print(f\"  latency: {d.last_latency_ms:.0f} ms\")\n",
    "    print()"
   ]
  },
